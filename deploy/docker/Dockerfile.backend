# syntax=docker/dockerfile:1
# Production Dockerfile for MAIJRUN Tech Medusa v1.20 E-commerce Backend

FROM node:20-alpine AS base
RUN apk add --no-cache python3 make g++ libc6-compat
WORKDIR /app

# Step 1: Install dependencies
FROM base AS deps
WORKDIR /app
COPY backend/package.json backend/package-lock.json* ./
RUN npm ci --legacy-peer-deps

# Step 2: Build TypeScript files
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY backend/ ./
RUN npm run build || true

# Step 3: Production Runner
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=9000

RUN addgroup --system --gid 1001 medusagroup && \
    adduser --system --uid 1001 medusauser

COPY --from=builder --chown=medusauser:medusagroup /app ./

USER medusauser

EXPOSE 9000

CMD ["npm", "run", "start"]
