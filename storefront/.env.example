# ==============================================================================
# MAIJRUN Tech E-Commerce Platform — Environment Configuration
# ==============================================================================

# Core Application Settings
NEXT_PUBLIC_BASE_URL=http://localhost:8001
NEXT_PUBLIC_DEFAULT_REGION=bd
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test

# ==============================================================================
# Phase 7: Bangladesh Payment Gateway Credentials
# ==============================================================================

# 1. bKash Merchant (Tokenized Checkout API v2)
# Modes: "sandbox" or "live"
BKASH_ENV=sandbox
BKASH_APP_KEY=sandbox_app_key_maijrun
BKASH_APP_SECRET=sandbox_app_secret_maijrun
BKASH_USERNAME=sandbox_user_maijrun
BKASH_PASSWORD=sandbox_pass_maijrun

# 2. Nagad Merchant API
# Modes: "sandbox" or "live"
NAGAD_ENV=sandbox
NAGAD_MERCHANT_ID=683002007104225
NAGAD_MERCHANT_PG_PUBLIC_KEY=sandbox_nagad_public_key
NAGAD_MERCHANT_PRIVATE_KEY=sandbox_nagad_private_key

# 3. SSLCommerz (Cards & Net Banking)
# Modes: "false" for sandbox, "true" for live
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_STORE_ID=maijruntechlive
SSLCOMMERZ_STORE_PASS=sandbox_pass_maijrun

# 4. Cash on Delivery (COD)
# Enabled by default with zero advance fee
ENABLE_CASH_ON_DELIVERY=true

# ==============================================================================
# Phase 9: SMS Gateways, Phone OTP Authentication & Couriers
# ==============================================================================

# 1. SMS Gateway Provider
# Modes: "mock" (sandbox/tests), "sslwireless", "bulksmsbd", or "twilio"
SMS_GATEWAY_PROVIDER=mock

# SSL Wireless SMS API
SSL_WIRELESS_API_TOKEN=your_ssl_wireless_api_token
SSL_WIRELESS_SID=MAIJRUNTECH
SSL_WIRELESS_DOMAIN=https://smsplus.sslwireless.com

# BulkSMSBD API
BULKSMSBD_API_KEY=your_bulksmsbd_api_key
BULKSMSBD_SENDER_ID=MAIJRUN

# Twilio SMS API
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890

# 2. Cryptographic Secrets & Abuse Prevention
OTP_SECRET=maijrun_otp_secure_hmac_secret_2026
SESSION_SECRET=maijrun_auth_session_secure_secret_2026
TURNSTILE_SECRET_KEY=0x4AAAAAAAx_your_cloudflare_turnstile_secret
DAILY_SMS_CAP=1000

# 3. Bangladesh Courier Partner Integrations
# Modes: "mock" (sandbox/tests), "steadfast", or "pathao"
COURIER_GATEWAY_PROVIDER=mock
COURIER_WEBHOOK_SECRET=maijrun_courier_webhook_secret_2026

# Steadfast Courier API
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

# Pathao Courier API
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_WEBHOOK_SECRET=your_pathao_webhook_secret
PATHAO_BASE_URL=https://api-hermes.pathao.com/aladdin/api/v1
